{
  "name": "@game/e2e",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "node -e \"\"",
    "pretest": "pnpm --filter @game/server build && pnpm --filter @game/rules-engine build",
    "test": "vitest run --no-file-parallelism",
    "pretypecheck": "pnpm --filter @game/schema build && pnpm --filter @game/rules-engine build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@game/rules-engine": "workspace:*",
    "@game/schema": "workspace:*",
    "@game/server": "workspace:*",
    "pg": "8.16.3",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/node": "26.0.0",
    "@types/pg": "8.15.5",
    "typescript": "5.9.3",
    "@types/ws": "8.18.1"
  },
  "type": "module"
}
