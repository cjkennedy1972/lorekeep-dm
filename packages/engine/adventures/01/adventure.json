{
  "id": "adventure:01-hollow-under-marrowfell",
  "title": "The Hollow Under Marrowfell",
  "premise": "The well of Marrowfell has turned bitter. Descend through the buried Tallow Hold and decide what becomes of its guttering Ember Lamp.",
  "toneLine": "Lamplit and creeping: old stone, wet cold, small mercies.",
  "startingSceneId": "scene-marowfell-well",
  "scenes": [
    {
      "id": "scene-marowfell-well",
      "title": "Marrowfell Well",
      "text": "The well-head is ringed with dead lamps. Nessa Kell asks you to descend beneath Gallows Knoll and discover why the water turned bitter.",
      "nextSceneIds": ["scene-broken-gatehouse"],
      "npcIds": ["npc_nessa_kell"]
    },
    {
      "id": "scene-broken-gatehouse",
      "title": "Broken Gatehouse",
      "text": "A leaning gate tower spills rubble across the flagged yard. Cold air smells of tallow and wet rat.",
      "nextSceneIds": ["scene-chapel-of-wicks"],
      "encounterIds": ["encounter-e1-rats"]
    },
    {
      "id": "scene-chapel-of-wicks",
      "title": "Chapel of Wicks",
      "text": "Six iron sconces line the vaulted chapel; a stone door has six cup-shaped hollows and no handle.",
      "nextSceneIds": ["scene-warren-gallery"],
      "npcIds": ["npc_tobren_vask"]
    },
    {
      "id": "scene-warren-gallery",
      "title": "Cinderwick Warren Gallery",
      "text": "The stair opens into a long gallery hung with rags and drying bones. Somewhere ahead a goblin hums off-key.",
      "nextSceneIds": ["scene-tallow-larder"],
      "encounterIds": ["encounter-e2-lookouts"]
    },
    {
      "id": "scene-tallow-larder",
      "title": "Tallow Larder",
      "text": "A dry cellar of shelves and barrels has been swept clean. A frightened goblin called Pip Ashgrub watches from behind a barrel.",
      "nextSceneIds": ["scene-boss-hall"],
      "npcIds": ["npc_pip_ashgrub"]
    },
    {
      "id": "scene-boss-hall",
      "title": "Boss Hall",
      "text": "Pillars and a dragged table divide the feasting hall. Skarrik Cinderwick wears a stolen breastplate and watches the doorway.",
      "nextSceneIds": ["scene-winch-shaft"],
      "encounterIds": ["encounter-e3-skarrik"]
    },
    {
      "id": "scene-winch-shaft",
      "title": "Winch Shaft",
      "text": "A black shaft drops below a greased chain lift. The descent is one-way; the lift will not return.",
      "nextSceneIds": ["scene-lamp-vault"]
    },
    {
      "id": "scene-lamp-vault",
      "title": "Lamp Vault",
      "text": "In the round grey vault, the Ember Lamp gutters on a stone pedestal. Shapes of smoke drift and watch.",
      "encounterIds": ["encounter-e4-wardens"]
    }
  ],
  "npcs": [
    {
      "id": "npc_nessa_kell",
      "name": "Nessa Kell",
      "role": "Well-warden and quest giver",
      "disposition": "friendly",
      "facts": [
        "The well turned bitter nine days ago and the well-head lamps cannot be relit.",
        "Gallows Knoll opened beneath a ram; Tallow Hold was built by lamp-keepers.",
        "The Ember Lamp keeps something quiet below; Nessa offers 20 gp now and 60 gp on return."
      ]
    },
    {
      "id": "npc_tobren_vask",
      "name": "Tobren Vask",
      "role": "Trapped surveyor",
      "disposition": "friendly",
      "facts": [
        "The Chapel of Wicks opens when its six wicks are lit low to high.",
        "Tobren mapped Level 2; the winch chain is greased despite disuse.",
        "The Cinderwick boss wears a stolen breastplate."
      ]
    },
    {
      "id": "npc_pip_ashgrub",
      "name": "Pip Ashgrub",
      "role": "Goblin deserter",
      "disposition": "neutral",
      "facts": [
        "Skarrik keeps the Cinderwick key on a cord around his neck.",
        "Goblins will not enter the warded Tallow Larder.",
        "The boss hall has a back door; the smoke people grease the chain each dusk."
      ]
    }
  ],
