{
  "name": "@game/rules-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./catalog-node": "./dist/catalog-node.js",
    "./scripted-node": "./dist/scripted-node.js",
    "./room-tools": "./dist/room-tools.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretypecheck": "pnpm --filter @game/schema build",
    "pretest": "pnpm --filter @game/schema build",
    "prebuild": "pnpm --filter @game/schema build",
    "test:geometry": "vitest run test/geometry-gate.test.ts test/properties.test.ts",
    "pretest:geometry": "pnpm --filter @game/schema build"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "26.0.0"
  },
  "dependencies": {
    "@game/schema": "workspace:*"
  }
}
