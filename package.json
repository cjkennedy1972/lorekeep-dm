{
  "name": "lorekeep-dm",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "build": "pnpm --filter @game/schema build && pnpm -r build",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @game/schema build && pnpm -r test",
    "typecheck": "pnpm --filter @game/schema build && pnpm -r typecheck",
    "test:geometry": "pnpm --filter @game/rules-engine test:geometry",
    "check:assets": "node scripts/check-assets.mjs",
    "eval:v0": "pnpm --filter @game/evals eval:v0"
  },
  "devDependencies": {
    "@eslint/js": "9.37.0",
    "eslint": "9.37.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "fast-check": "4.10.2",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.45.0",
    "vitest": "3.2.4"
  },
  "type": "module"
}
