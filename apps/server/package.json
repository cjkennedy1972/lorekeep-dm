    "migrate:down": "node-pg-migrate down -m migrations"
  },
  "dependencies": {
    "fastify": "5.6.2",
    "pg": "8.16.3",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/node": "26.0.0",
    "@types/pg": "8.15.5",
    "@types/ws": "8.18.1",
    "node-pg-migrate": "8.0.3",
    "typescript": "5.9.3"
  }
}
